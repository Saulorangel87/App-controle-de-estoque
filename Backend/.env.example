JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria-aqui

# Usada só na importação de nota por FOTO DE CUPOM DE PAPEL FÍSICO (print de
# tela continua usando o Tesseract local, sem precisar de chave nenhuma).
# Pegue a sua grátis em https://ocr.space/ocrapi/freekey — sem cartão de
# crédito. Se deixar em branco, essa opção específica fica indisponível com
# uma mensagem clara no app (as outras continuam funcionando normalmente).
OCR_SPACE_API_KEY=

# Resend: domínio remetente verificado e chave criada no painel do Resend.
# Nunca committe a chave real; em produção, informe-a somente no .env da VPS.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@devsaulo.com.br
